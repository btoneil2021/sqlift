# Supabase Database Configuration
# Get this from your own Supabase project: Project Settings > Database > Connection string > Transaction pooler
# Format: postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.<your-project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:6543/postgres"

# The password for your Supabase database (replaces [YOUR-PASSWORD] in the URL above)
DATABASE_PASSWORD="your-supabase-db-password"

# A long random string used to sign session tokens — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-long-random-string"